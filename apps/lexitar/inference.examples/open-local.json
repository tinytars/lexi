{
  "$doc": "Fully open weights, self-hosted, no vendor account and no key. Copy over inference.config.json. Measured numbers and the hardware they were measured on are in MEASUREMENT.md; MODELS.md says which features this stack can and cannot serve. Every feature that answers about a person's record is attached to that person's reports, which are PDFs, so this stack requires REPORTS: \"never\" in wrangler.jsonc's vars (CORPUS.md) — with it on, the features below whose provider declares pdf:false refuse with 422 model_unsupported rather than answering from less.",
  "providers": {
    "local-text": {
      "api": "openai",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "keyEnv": [],
      "caps": { "vision": false, "pdf": false, "jsonSchema": true, "tools": false },
      "maxTokensField": "max_tokens",
      "maxOutputTokens": 4096
    },
    "local-vision": {
      "api": "openai",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "keyEnv": [],
      "caps": { "vision": true, "pdf": false, "jsonSchema": true, "tools": false },
      "maxTokensField": "max_tokens",
      "maxOutputTokens": 4096
    }
  },
  "features": {
    "chat": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "persona": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "extract": { "provider": "local-vision", "model": "qwen2.5vl:3b" },
    "document": { "provider": "local-vision", "model": "qwen2.5vl:3b" },
    "treatmentImage": { "provider": "local-vision", "model": "qwen2.5vl:3b" },
    "treatmentText": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "finding": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "ranges": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "markerGroups": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "leafRegen": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" },
    "benchmarkWeakest": { "provider": "local-text", "model": "qwen3:4b-instruct-2507-q4_K_M" }
  },
  "dev": {}
}
