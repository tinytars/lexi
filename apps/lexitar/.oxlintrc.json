{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "coverage",
    ".wrangler",
    "records",
    "public",
    "tests/fixtures/prompt-golden"
  ],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "eslint/no-unassigned-vars": "off",
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/**",
        "scripts/**"
      ],
      "rules": {
        "eslint/no-unused-expressions": "off"
      }
    }
  ]
}
