{
  "name": "lexitar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "allowlist": "tsx scripts/chat-allowlist.ts",
    "vault:snapshot": "tsx scripts/vault-snapshot.ts",
    "vault:restore": "tsx scripts/vault-restore.ts",
    "vault:snapshot:check": "tsx scripts/vault-snapshot-check.ts",
    "vault:rotate": "tsx scripts/rotate-pilot-credentials.ts",
    "dag:mermaid": "tsx scripts/gen-dag-mermaid.ts",
    "dag:push": "tsx scripts/export-finding-dag-vault.ts",
    "dag:pull": "tsx scripts/import-finding-dag-vault.ts",
    "neuro-pil:lint": "tsx scripts/neuro-pil-lint.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --threshold error && tsc -p tsconfig.node.json",
    "wrangler": "bash scripts/wrangler.sh",
    "d1:migrate:remote": "bash scripts/d1-migrate.sh --remote",
    "d1:migrate:local": "bash scripts/d1-migrate.sh --local",
    "test": "vitest run",
    "test:data": "vitest run --config vitest.data.config.ts",
    "test:watch": "vitest",
    "e2e:clean": "bash scripts/e2e-clean.sh",
    "e2e:serve": "bash scripts/e2e-serve.sh",
    "test:e2e": "npm run e2e:clean && NODE_OPTIONS='--import ./scripts/e2e-node-modules-ts-register.mjs' playwright test",
    "test:all": "npm run test && npm run test:data && npm run test:e2e",
    "dev:functions": "npm run build && wrangler pages dev dist",
    "doc:read-check": "tsx scripts/document-read-check.ts",
    "coverage": "vitest run --coverage",
    "prompt:golden": "tsx scripts/gen-prompt-golden.ts",
    "lint": "oxlint src functions scripts tests --deny-warnings",
    "brain:versions": "tsx scripts/gen-brain-versions.ts",
    "recovery:approve": "tsx scripts/recovery-approve.ts",
    "raw:backfill": "tsx scripts/raw-backfill.ts",
    "r2-ops": "tsx scripts/r2-ops-cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "miniflare": "4.20260625.0",
    "playwright": "^1.60.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.0",
    "wrangler": "^4.43.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@pablotech/akesi": "^0.1.43",
    "@pablotech/neuro": "^0.1.43",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^14.0.1",
    "@tinytars/frame": "^0.1.5",
    "@tinytars/vault": "^0.1.18",
    "pdfjs-dist": "^6.2.108",
    "xlsx": "^0.18.5"
  }
}
